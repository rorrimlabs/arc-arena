# Security headers for the admin dashboard (Cloudflare Pages / Netlify `_headers` format; on
# another host set the same headers there). The CSP allows only this origin plus what the app
# loads: Supabase (REST, Auth, Realtime), Google Fonts and Cloudflare
# Turnstile (the sign-in / sign-up / invitation security check). Angular's
# component styles are inline <style> tags, hence style-src 'unsafe-inline'; no inline script
# is allowed (critical-CSS inlining is off in angular.json for that reason).
# The PWA service worker re-fetches every request it sees, so connect-src also lists the font
# and Turnstile origins.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/index.html
  Cache-Control: no-cache

/ngsw-worker.js
  Cache-Control: no-cache

/ngsw.json
  Cache-Control: no-cache
