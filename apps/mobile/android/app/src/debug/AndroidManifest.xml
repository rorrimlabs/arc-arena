<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- DEBUG ONLY: lets an emulator reach the local Supabase dev stack over
         plain http (http://10.0.2.2:54431, dart_define.local-android.json).
         Release builds keep Android's https-only default, and the app itself
         refuses a non-https backend in a release build. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
