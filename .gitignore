# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/apps/mobile/build/
/apps/mobile/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/apps/mobile/android/app/debug
/apps/mobile/android/app/profile
/apps/mobile/android/app/release

# Widget Preview related
.widget_preview/

# Platform folders Flutter generates when a command runs from the repo root.
# The app's real platform folders are under apps/mobile/.
/android/
/ios/
/linux/
/macos/
/windows/

# ---------------------------------------------------------------------------
# arena_ops — backend/sync additions (added at Phase 0, see docs + plan).
# Keep Supabase credentials and any on-device database copies OUT of git.
# ---------------------------------------------------------------------------

# Environment & secrets: Supabase URL/keys, --dart-define-from-file inputs.
# NEVER commit a service-role key; the anon key also lives only in these files.
*.env
.env
.env.*
/env/
dart_define.json
dart_define.dev.json
dart_define.hosted-dev.json
dart_define*.json
*.dart-define.json
*.secrets.json
# Allow committed, non-secret templates (e.g. .env.example, dart_define.example.json).
!.env.example
!.env.*.example
!*.example.env
!dart_define.example.json
!*.example.json
# The local Supabase stack (fixed localhost URL + its publishable key, same as apps/admin environment.ts).
!dart_define.local.json
!dart_define.local-android.json

# Admin dashboard: environment.ts (local stack) and environment.production.ts (empty
# template the default build and CI compile) are tracked. Per-machine and staging copies
# are made from environment.staging.example.ts and never committed.
/apps/admin/src/environments/environment.local.ts
/apps/admin/src/environments/environment.staging.ts

# Private signing keys, keystores, and certificate files
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.der
*.p8
*.mobileprovision
key.properties
local.properties
**/android/key.properties
**/android/local.properties

# Built app packages (release/staging builds are made locally, never committed).
*.apk
*.aab
*.ipa

# Hosting CLI state and local secrets (Cloudflare Wrangler, Netlify, Vercel).
.wrangler/
.dev.vars
.dev.vars.*
.netlify/
.vercel/

# Service account credentials & cloud service configs
*service-account*.json
*credentials*.json
firebase-adminsdk*.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Supabase CLI local-stack state (created by `supabase init` / `supabase start`).
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# Stray on-device SQLite files or backups copied in for debugging. The real
# database and its arena_ops-backups/ folder live in the app's documents
# directory on-device, never in the repo — this is belt-and-braces.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
arena_ops-backups/

# Sentry: the downloaded setup wizard (a large executable), the CLI's auth-token
# config and upload settings, and symbol/source-map upload output. The DSN and
# the auth token are passed at build time (dart-defines / SENTRY_AUTH_TOKEN),
# never committed.
sentry-wizard
**/sentry-wizard
.sentryclirc
**/.sentryclirc
sentry.properties
**/sentry.properties
.env.sentry-build-plugin
**/.env.sentry-build-plugin
**/sentry_debug_symbols/

# Node dependencies at any level (apps/admin has its own ignore too).
node_modules/
