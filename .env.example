# ARQ — Environment Configuration Template (Placeholders only)
# Copy to .env or .env.local for local development. NEVER commit real credentials.

# Backend selection: 'local' (offline Drift/SQLite) or 'supabase' (cloud sync)
AO_BACKEND=supabase

# Supabase project URL (e.g. http://127.0.0.1:54431 for local stack, or https://<ref>.supabase.co for hosted)
AO_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase publishable / anon key (public API key) — NEVER use service_role key or database password
AO_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
